{
  "name": "fill-in-the-blank",
  "version": "0.0.5",
  "description": "Word generator",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "badge": "badge-roll affix",
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "start": "ts-node --esm ./dev/run.ts",
    "test": "vitest run --no-allowOnly",
    "test:watch": "vitest"
  },
  "author": "Alex Gorischek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agorischek/fill-in-the-blank"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "badge-roll": "^0.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "llm",
    "prompting",
    "random"
  ],
  "overrides": {
    "yaml": "1.10.3"
  }
}
